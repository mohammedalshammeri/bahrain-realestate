{
  "expo": {
    "name": "Bahrain Property Hub",
    "slug": "bahrain-property-hub",
    "version": "1.0.0",
    "scheme": "bahrain-property-hub",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "supportsRTL": true,
      "bundleIdentifier": "com.bahrainpropertyhub.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to upload property images.",
        "NSCameraUsageDescription": "This app requires access to your camera to take property photos directly.",
        "NSPhotoLibraryAddUsageDescription": "This app requires access to save photos",
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to show nearby properties.",
        "LSApplicationQueriesSchemes": ["whatsapp", "tel", "mailto"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "supportsRTL": true,
      "package": "com.bahrainpropertyhub.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "usesCleartextTraffic": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supportsRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-localization"
    ]
  }
}
