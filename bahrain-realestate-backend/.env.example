# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── JWT ────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ─── Server ─────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=https://admin.yourdomain.com,https://yourdomain.com

# ─── SMTP (for password reset emails) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
