# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── JWT ────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# ─── Server ─────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
BACKEND_PUBLIC_URL=https://api.bphub.app

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=https://admin.bphub.app,https://bphub.app

# ─── AFS Payment ────────────────────────────────────────────
AFS_RETURN_URL=https://bphub.app/payment/return
AFS_CALLBACK_URL=https://api.bphub.app/api/company/payments/afs-callback

# ─── SMTP (for password reset emails) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bphub.app
SMTP_PASS=your-app-password
SMTP_FROM=info@bphub.app
